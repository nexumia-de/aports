# Contributor: nexumia-de <https://github.com/nexumia-de>
# Based on Alpine's testing/android-translation-layer and upstream's
# nightly APKBUILD (JDK 17 and -Ddownload_tool_deps=true for
# tools/jni_upcall_gen). _commit and pkgver are updated by
# scripts/update.sh.
pkgname=android-translation-layer
pkgver=0_git20261113092057
pkgrel=0
_commit="7753cefb049df8d61f05a404c1730fed40e52342"
pkgdesc="A translation layer for running Android apps on a Linux system (nexumia-de Phosh fork)"
url="https://github.com/nexumia-de/android_translation_layer"
arch="aarch64"
license="GPL-3.0-only"
# libopensles-standalone is not strictly required but some Android applications depend on it
depends="libopensles-standalone"
makedepends="
	alsa-lib-dev
	art_standalone-dev
	bionic_translation-dev
	ffmpeg-dev
	fontconfig-dev
	glib-dev
	gtk4-layer-shell-dev
	gtk4.0-dev
	java-common
	libadwaita-dev
	libandroidfw-dev
	libgudev-dev
	libportal-dev
	libsecret-dev
	maven
	meson
	openjdk17-jdk
	openxr-dev
	vulkan-loader-dev
	webkit2gtk-6.0-dev
	"
# maven downloads the Java libraries of tools/jni_upcall_gen
options="net"
source="android_translation_layer-$_commit.tar.gz::https://github.com/nexumia-de/android_translation_layer/archive/$_commit.tar.gz"
builddir="$srcdir/android_translation_layer-$_commit"

build() {
	abuild-meson -Ddownload_tool_deps=true \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
878d92d24abb34ebe527648978f3b184f99278c918f5c7d224b7a0230f14f5ce01b525603d720c3047f3b5833a42fc3a4c1114c9f7f6cbb1c8956c598403266f  android_translation_layer-7753cefb049df8d61f05a404c1730fed40e52342.tar.gz
"
