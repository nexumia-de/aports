From: nexumia-de <https://github.com/nexumia-de>
Subject: Make libcore's own lambdas work: LambdaMetafactory and Object... bootstrap arguments

art_standalone compiles libcore with dx, which keeps the invokedynamic of
libcore's own lambdas, while Android desugars them with D8 and ships a
LambdaMetafactory stub that returns null. Every lambda inside libcore
therefore threw "BootstrapMethodError: ... Bootstrap method returned
null", e.g. in the static initializer of java.time.format.
DateTimeFormatterBuilder, so DateTimeFormatter could not be used at all
(DB Navigator crashed on start).

- LambdaMetafactory builds each lambda as a java.lang.reflect.Proxy that
  calls the implementation MethodHandle; the call site target is a
  Transformer with exactly the invokedType, which the runtime checks.
- ART collects the static arguments of a variable arity bootstrap method
  only when all have the array's component type; altMetafactory takes
  Object..., which Comparator.comparing and the other serializable
  lambdas in libcore use. Collect mixed arguments into an Object[] and
  box the scalar ones.

---
diff --git a/art/runtime/interpreter/interpreter_common.cc b/art/runtime/interpreter/interpreter_common.cc
index 30c4b90e..be3692c2 100644
--- a/art/runtime/interpreter/interpreter_common.cc
+++ b/art/runtime/interpreter/interpreter_common.cc
@@ -1158,6 +1158,50 @@ static bool PackCollectorArrayForBootstrapMethod(Thread* self,
     COLLECT_REFERENCE_ARRAY(mirror::String, String);
   } else if (component_type == GetClassRoot<mirror::Class>()) {
     COLLECT_REFERENCE_ARRAY(mirror::Class, Type);
+  } else if (component_type->IsObjectClass()) {
+    // Object... takes mixed arguments, as for LambdaMetafactory.altMetafactory;
+    // scalar ones are boxed.
+    Handle<mirror::ObjectArray<mirror::Object>> array =
+        hs.NewHandle(mirror::ObjectArray<mirror::Object>::Alloc(self, array_type, array_length));
+    if (array.IsNull()) {
+      return false;
+    }
+    for (int32_t i = 0; it->HasNext(); it->Next(), ++i) {
+      auto type = it->GetValueType();
+      const JValue encoded_value = ConvertScalarBootstrapArgument(it->GetJavaValue());
+      if (!GetArgumentForBootstrapMethod(self, referrer, type, &encoded_value, &decoded_value)) {
+        return false;
+      }
+      ObjPtr<mirror::Object> o;
+      switch (type) {
+        case EncodedArrayValueIterator::ValueType::kInt:
+          o = BoxPrimitive(Primitive::kPrimInt, decoded_value);
+          break;
+        case EncodedArrayValueIterator::ValueType::kFloat:
+          o = BoxPrimitive(Primitive::kPrimFloat, decoded_value);
+          break;
+        case EncodedArrayValueIterator::ValueType::kLong:
+          o = BoxPrimitive(Primitive::kPrimLong, decoded_value);
+          break;
+        case EncodedArrayValueIterator::ValueType::kDouble:
+          o = BoxPrimitive(Primitive::kPrimDouble, decoded_value);
+          break;
+        default:
+          o = decoded_value.GetL();
+          break;
+      }
+      if (UNLIKELY(o.IsNull())) {
+        DCHECK(self->IsExceptionPending());
+        return false;
+      }
+      if (Runtime::Current()->IsActiveTransaction()) {
+        array->Set<true>(i, o);
+      } else {
+        array->Set<false>(i, o);
+      }
+    }
+    setter->SetReference(array.Get());
+    return true;
   } else {
     UNREACHABLE();
   }
@@ -1290,8 +1334,10 @@ static ObjPtr<mirror::CallSite> InvokeBootstrapMethod(Thread* self,
       return nullptr;
     }
     // Check all the arguments to be collected match the collector array component type.
+    // An Object array takes any of them, boxing the scalar ones.
     for (int i = number_of_bsm_parameters - 1; i < call_site_type->GetNumberOfPTypes(); ++i) {
-      if (call_site_type->GetPTypes()->Get(i) != collector_array_class->GetComponentType()) {
+      if (call_site_type->GetPTypes()->Get(i) != collector_array_class->GetComponentType() &&
+          !collector_array_class->GetComponentType()->IsObjectClass()) {
         ThrowClassCastException(collector_array_class->GetComponentType(),
                                 call_site_type->GetPTypes()->Get(i));
         return nullptr;
diff --git a/libcore/ojluni/src/lambda/java/java/lang/invoke/LambdaMetafactory.java b/libcore/ojluni/src/lambda/java/java/lang/invoke/LambdaMetafactory.java
index e1ce46f3..b507d8bf 100644
--- a/libcore/ojluni/src/lambda/java/java/lang/invoke/LambdaMetafactory.java
+++ b/libcore/ojluni/src/lambda/java/java/lang/invoke/LambdaMetafactory.java
@@ -25,6 +25,21 @@
 
 package java.lang.invoke;
 
+import dalvik.system.EmulatedStackFrame;
+import dalvik.system.EmulatedStackFrame.StackFrameReader;
+import java.lang.reflect.Constructor;
+import java.lang.reflect.InvocationHandler;
+import java.lang.reflect.Method;
+import java.lang.reflect.Proxy;
+import java.util.Arrays;
+
+/*
+ * Android desugars lambdas with D8, so its LambdaMetafactory is a stub that
+ * returns null. art_standalone compiles libcore with dx, which keeps the
+ * invokedynamic of libcore's own lambdas (e.g. in java.time), so they need a
+ * working metafactory. This one builds each lambda as a java.lang.reflect.Proxy
+ * that calls the implementation method through its MethodHandle.
+ */
 public class LambdaMetafactory {
 
     public static final int FLAG_SERIALIZABLE = 1 << 0;
@@ -39,11 +54,152 @@ public class LambdaMetafactory {
                                        MethodType samMethodType,
                                        MethodHandle implMethod,
                                        MethodType instantiatedMethodType)
-            throws LambdaConversionException { return null; }
+            throws LambdaConversionException {
+        return makeCallSite(caller, invokedName, invokedType, implMethod, new Class<?>[0]);
+    }
 
     public static CallSite altMetafactory(MethodHandles.Lookup caller,
                                           String invokedName,
                                           MethodType invokedType,
                                           Object... args)
-            throws LambdaConversionException { return null; }
+            throws LambdaConversionException {
+        // args: samMethodType, implMethod, instantiatedMethodType, flags,
+        // [marker count, markers...], [bridge count, bridges...]
+        MethodHandle implMethod = (MethodHandle) args[1];
+        int flags = (Integer) args[3];
+        Class<?>[] markers = new Class<?>[0];
+        if ((flags & FLAG_MARKERS) != 0) {
+            int count = (Integer) args[4];
+            markers = Arrays.copyOfRange(args, 5, 5 + count, Class[].class);
+        }
+        // bridges share the method name, which is all the proxy dispatches on
+        return makeCallSite(caller, invokedName, invokedType, implMethod, markers);
+    }
+
+    private static CallSite makeCallSite(MethodHandles.Lookup caller, String samName,
+                                         MethodType invokedType, MethodHandle implMethod,
+                                         Class<?>[] markers)
+            throws LambdaConversionException {
+        Class<?>[] interfaces = new Class<?>[markers.length + 1];
+        interfaces[0] = invokedType.returnType();
+        System.arraycopy(markers, 0, interfaces, 1, markers.length);
+        try {
+            Class<?> proxyClass = Proxy.getProxyClass(caller.lookupClass().getClassLoader(), interfaces);
+            LambdaFactory factory = new LambdaFactory(samName, implMethod,
+                    proxyClass.getConstructor(InvocationHandler.class));
+            if (invokedType.parameterCount() == 0) {
+                // a lambda that captures nothing is one shared instance, as on the JVM
+                return new ConstantCallSite(MethodHandles.constant(interfaces[0], factory.newInstance(new Object[0])));
+            }
+            return new ConstantCallSite(new Capture(invokedType, factory));
+        } catch (ReflectiveOperationException | RuntimeException e) {
+            throw new LambdaConversionException(e);
+        }
+    }
+
+    private static final class LambdaFactory {
+        private final String samName;
+        private final MethodHandle implMethod;
+        private final MethodHandle implInvoker;
+        private final Constructor<?> proxyConstructor;
+
+        LambdaFactory(String samName, MethodHandle implMethod, Constructor<?> proxyConstructor) {
+            this.samName = samName;
+            this.implMethod = implMethod;
+            this.proxyConstructor = proxyConstructor;
+            // invokeWithArguments needs the type's MethodTypeForm, which the
+            // MethodTypes the runtime creates for call sites lack; an equal
+            // type made here has one
+            MethodType type = implMethod.type();
+            implInvoker = MethodHandles.spreadInvoker(
+                    MethodType.methodType(type.returnType(), type.parameterArray()), 0);
+        }
+
+        Object newInstance(Object[] captured) throws ReflectiveOperationException {
+            return proxyConstructor.newInstance(new LambdaHandler(this, captured));
+        }
+    }
+
+    /*
+     * The call site's target. The runtime requires its real type to be the
+     * invokedType, which adapters from asType() do not change, so this reads
+     * the captured values from the frame itself.
+     */
+    private static final class Capture extends Transformers.Transformer {
+        private final LambdaFactory factory;
+
+        Capture(MethodType invokedType, LambdaFactory factory) {
+            super(invokedType);
+            this.factory = factory;
+        }
+
+        @Override
+        protected void transform(EmulatedStackFrame frame) throws Throwable {
+            StackFrameReader reader = new StackFrameReader();
+            reader.attach(frame);
+            Class<?>[] types = type().parameterArray();
+            Object[] captured = new Object[types.length];
+            for (int i = 0; i < types.length; i++)
+                captured[i] = readBoxed(reader, types[i]);
+            frame.setReturnValueTo(factory.newInstance(captured));
+        }
+
+        private static Object readBoxed(StackFrameReader reader, Class<?> type) {
+            if (!type.isPrimitive())
+                return reader.nextReference(type);
+            if (type == int.class)
+                return reader.nextInt();
+            if (type == long.class)
+                return reader.nextLong();
+            if (type == boolean.class)
+                return reader.nextBoolean();
+            if (type == char.class)
+                return reader.nextChar();
+            if (type == byte.class)
+                return reader.nextByte();
+            if (type == short.class)
+                return reader.nextShort();
+            if (type == float.class)
+                return reader.nextFloat();
+            return reader.nextDouble();
+        }
+    }
+
+    private static final class LambdaHandler implements InvocationHandler {
+        private final LambdaFactory factory;
+        private final Object[] captured;
+
+        LambdaHandler(LambdaFactory factory, Object[] captured) {
+            this.factory = factory;
+            this.captured = captured;
+        }
+
+        @Override
+        public Object invoke(Object proxy, Method method, Object[] args) throws Throwable {
+            if (args == null)
+                args = new Object[0];
+            if (method.getDeclaringClass() == Object.class) {
+                switch (method.getName()) {
+                    case "equals":
+                        return proxy == args[0];
+                    case "hashCode":
+                        return System.identityHashCode(proxy);
+                    default:
+                        return proxy.getClass().getName() + "@" + Integer.toHexString(System.identityHashCode(proxy));
+                }
+            }
+            if (method.isDefault()) {
+                // lookups from java.lang.invoke are refused, an accessible Method is not checked
+                method.setAccessible(true);
+                return MethodHandles.publicLookup().unreflectSpecial(method, method.getDeclaringClass())
+                        .bindTo(proxy).invokeWithArguments(args);
+            }
+            if (!method.getName().equals(factory.samName))
+                throw new AbstractMethodError(method.toString());
+            Object[] all = new Object[captured.length + args.length];
+            System.arraycopy(captured, 0, all, 0, captured.length);
+            System.arraycopy(args, 0, all, captured.length, args.length);
+            return factory.implInvoker.invoke(factory.implMethod, all);
+        }
+    }
 }
