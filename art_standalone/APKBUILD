# Contributor: nexumia-de <https://github.com/nexumia-de>
# Alpine's testing/art_standalone (alpinelinux/aports f35539597b0e),
# built from the fork's phosh branch: upstream plus the wolfssljni and
# lambda fixes F-Droid and DB Navigator need. _commit and pkgver are
# updated by scripts/update.sh.
pkgname=art_standalone
pkgver=0_git20261029052657
pkgrel=0
_commit="4acccadb06869fa8bae86c65ae7ea99cfbfde240"
pkgdesc="A standalone version of Dalvik with Art build in (nexumia-de fork)"
url="https://github.com/nexumia-de/art_standalone"
arch="aarch64"
license="Apache-2.0"
depends="
	java-cacerts
	wolfssl-jni
	"
# bash is used by /usr/bin/dx
depends_dev="
	$pkgname=$pkgver-r$pkgrel
	bash
	"
case "$CARCH" in
	aarch64|armv7) depends_dev="$depends_dev vixl-dev" ;;
esac
makedepends="$depends_dev
	bionic_translation-dev
	bsd-compat-headers
	expat-dev
	icu-dev
	java-common
	libbsd-dev
	libcap-dev
	libpng-dev
	libselinux-dev
	libunwind-dev
	lz4-dev
	meson
	openjdk8-jdk
	openssl-dev
	python3
	valgrind-dev
	wolfssl-jni-dev
	xz-dev
	zip
	zlib-dev
	"
somask="
	libart-compiler.so
	libart-dexlayout.so
	libart.so
	libartbase.so
	libartpalette.so
	libbacktrace.so
	libbase.so
	libcutils.so
	libdexfile.so
	liblog.so
	libnativebridge.so
	libnativehelper.so
	libopenjdkjvm.so
	libprofile.so
	libsigchain.so
	libunwind.so
	libutils.so
	libziparchive.so
	"
subpackages="
	libandroidfw
	libandroidfw-dev:libandroidfw_dev
	adbd
	$pkgname-dev
	"
source="art_standalone-$_commit.tar.gz::https://github.com/nexumia-de/art_standalone/archive/$_commit.tar.gz"
# No tests; no -dbg subpackage, it would be most of the repository's size
options="!check !dbg"
builddir="$srcdir/art_standalone-$_commit"

build() {
	make ____PREFIX=/usr ____LIBDIR=lib
	make adbd
}

package() {
	make \
		____PREFIX="$pkgdir"/usr \
		____INSTALL_ETC="$pkgdir"/etc \
		____LIBDIR=lib \
		install
	make \
		____PREFIX="$pkgdir"/usr \
		install_adbd
}

dev() {
	default_dev

	amove \
		usr/lib/java/core-all_classes.jar \
		usr/lib/java/dx.jar \
		usr/bin/dx
}

libandroidfw() {
	depends=""
	amove usr/lib/art/libandroidfw.so
}

libandroidfw_dev() {
	depends="libandroidfw"

	amove usr/include/androidfw/androidfw_c_api.h
}

adbd() {
	depends="$pkgname"
	amove usr/bin/adbd
}

sha512sums="
37106449642d56894cc516adb97afa838311bbcc391e5bc72d4b1b72dff55d0c385df06f09b2e3785e12999498890680a88f49f86c63ba924b4113ac12db12de  art_standalone-4acccadb06869fa8bae86c65ae7ea99cfbfde240.tar.gz
"
