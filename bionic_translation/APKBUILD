# Contributor: nexumia-de <https://github.com/nexumia-de>
# Alpine's testing/bionic_translation (alpinelinux/aports f35539597b0e),
# built from the fork's phosh branch: upstream plus __register_atfork
# and __strncat_chk, which DB Navigator's native libraries need. _commit
# and pkgver are updated by scripts/update.sh.
pkgname=bionic_translation
pkgver=0_git20261102192202
pkgrel=0
_commit="5ea020a02c28e4fd2e45af35c0f55ba3ee43d86b"
pkgdesc="A set of libraries for loading bionic-linked .so files on musl/glibc (nexumia-de fork)"
url="https://github.com/nexumia-de/bionic_translation"
arch="aarch64"
license="Apache-2.0"
makedepends="
	elfutils-dev
	libbsd-dev
	libunwind-dev
	mesa-dev
	meson
	samurai
	"
checkdepends="bubblewrap"
subpackages="$pkgname-dev $pkgname-dbg"
source="bionic_translation-$_commit.tar.gz::https://github.com/nexumia-de/bionic_translation/archive/$_commit.tar.gz"
options="!check" # Tests require bubblewrap which can not run in CI/containerized environments
builddir="$srcdir/bionic_translation-$_commit"

build() {
	abuild-meson \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
ba318698bcab0fc62471866e7789759e3b8f2e4ad24330a3cd1f70ab47b09fb779d87aa23e92efc380408c5a71e328ed3829150a4cfc9be24ae8baa9928dba2b  bionic_translation-5ea020a02c28e4fd2e45af35c0f55ba3ee43d86b.tar.gz
"
